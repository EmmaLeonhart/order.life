# Generated site output (rebuild with: python build.py)
site/
site_tmp/

# Python
__pycache__/
*.pyc

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Local AI tool state
**/settings.local.json

# Repair-verification snapshot (wiki-scripts/verify_repair.py --snapshot)
wikibase/analysis/.repair_snapshot.tsv

# In-progress extract output (wiki-scripts/extract_genealogy.py AtomicWrite).
# Every output is written to <name>.tmp and os.replace'd into place only when the run
# completes, so a killed run leaves one of these behind. Transient by definition, and
# without this rule an auto-commit landing mid-extract would commit a half-written TSV --
# which is the failure the atomic writes exist to prevent, arriving by another door.
wikibase/analysis/*.tsv.tmp
