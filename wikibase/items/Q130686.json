  "descriptions": {
    "bn": {
      "language": "bn",
      "value": "গ্রিক পুরাণের দেবতাদের বার্তাবাহক এবং পাতালের অন্যতম পথপদর্শক"
    },
    "ca": {
      "language": "ca",
      "value": "personatge de la mitologia grega"
    },
    "cs": {
      "language": "cs",
      "value": "bůh z řecké mytologie"
    },
    "da": {
      "language": "da",
      "value": "handelens, købmændenes og tyvenes gud i græsk mytologi"
    },
    "de": {
      "language": "de",
      "value": "Götterbote in der griechischen Mythologie"
    },
    "el": {
      "language": "el",
      "value": "θεός της ελληνικής μυθολογίας"
    },
    "en": {
      "language": "en",
      "value": "Olympian god in Greek religion and mythology; the emissary and messenger of the gods; the god of trade, heraldry, merchants, commerce, roads, thieves, trickery, sports, travelers, and athletes; the son of Zeus and the Pleiad Maia"
    },
    "eo": {
      "language": "eo",
      "value": "helena dio; la kuriero de la dioj; la dio de komerco, vojaĝo, ŝtelo, ruzo, kaj sporto; filo de Zeŭso"
    },
    "es": {
      "language": "es",
      "value": "heraldo de los dioses en la mitología griega"
    },
    "eu": {
      "language": "eu",
      "value": "olinpiar jainkoen mezularia; mugen, bidaiaren, ingenioaren, merkataritzaren, azkartasunaren eta gezurren jainkoa zen"
    },
    "fa": {
      "language": "fa",
      "value": "خدای باستانی مرزها و مسافران در یونان باستان"
    },
    "fi": {
      "language": "fi",
      "value": "kreikkalaisen mytologian jumala"
    },
    "fr": {
      "language": "fr",
      "value": "divinité de l'Olympe dans la mythologie grecque"
    },
    "gl": {
      "language": "gl",
      "value": "deus da mitoloxía grega, fillo de Zeus"
    },
    "he": {
      "language": "he",
      "value": "אל במיתולוגיה היוונית, שליח האלים פטרון הרופאים, הסוחרים, הנוודים והגנבים"
    },
    "hu": {
      "language": "hu",
      "value": "az istenek hírnöke a görög mitológiában"
    },
    "hy": {
      "language": "hy",
      "value": "հին հունական աստված, Զևսի և Մայայի որդին"
    },
    "id": {
      "language": "id",
      "value": "Dewa pembawa pesan, perdagangan, pencurian, perjalanan, pelindung daerah perbatasan, para pengelana, gembala, penipu, pidato, olahraga, pengukuran, penemuan, sastra dan puisi"
    },
    "it": {
      "language": "it",
      "value": "dio greco del commercio, dei viaggi, dei confini, dei ladri e dell'eloquenza, messaggero degli dèi e psicopompo"
    },
    "ja": {
      "language": "ja",
      "value": "ギリシア神話の神、オリュンポス十二神"
    },
    "ko": {
      "language": "ko",
      "value": "그리스 신화에 등장하는 올림피아의 신; 신들의 사자; 무역과 전령, 상인, 상업, 도로, 도둑, 속임수, 체육, 여행자, 운동선수의 신; 제우스의 아들이자 플레이아데스 마이아의 아들"
    },
    "ku": {
      "language": "ku",
      "value": "di mîtolojiya yewnanî de peyamnêrê xwedawenda"
    },
    "la": {
      "language": "la",
      "value": "in mythologia Graeca, nuntius legatusque deorum et ipse deus mercatorum, furum, oratorum, nuntiorum"
    },
    "lb": {
      "language": "lb",
      "value": "griichesche Gott"
    },
    "nl": {
      "language": "nl",
      "value": "god en boodschapper van de goden in de Griekse mythologie"
    },
    "oc": {
      "language": "oc",
      "value": "lo grand messatgièr dels Dieus dins la mitologia grèga e lo guida del monde dels mòrts"
    },
    "pl": {
      "language": "pl",
      "value": "bóg w mitologii greckiej"
    },
    "pt": {
      "language": "pt",
      "value": "deus grego da fertilidade, dos rebanhos, da magia, da divinação, das estradas e viagens, entre outros atributos"
    },
    "ro": {
      "language": "ro",
      "value": "zeul comerțului, al zborului și al hoților în mitologia greacă"
    },
    "ru": {
      "language": "ru",
      "value": "в древнегреческой мифологии бог торговли, ловкости и красноречия"
    },
    "si": {
      "language": "si",
      "value": "ග්‍රීක ආගමේ සහ පුරාණෝක්තිවේදයේ එන දෙවියා; දෙවියන්ගේ පණිවුඩකරු; වෙළඳාම, දේශාටනය, වාණිජ්‍යය, මාර්ග, සොරුන්, කපටභාවය, ක්‍රීඩා සහ මලලක්‍රීඩකයන්ට අධිපති දෙවියා"
    },
    "sk": {
      "language": "sk",
      "value": "boh v gréckej a rímskej mytológii, ochranca cestovateľov, obchodníkov, pastvín a prírody"
    },
    "sl": {
      "language": "sl",
      "value": "sel bogov v grški mitologiji"
    },
    "sr": {
      "language": "sr",
      "value": "древни грчки бог граница, путева, трговаца, лукавости и лопова"
    },
    "sv": {
      "language": "sv",
      "value": "gudarnas budbärare samt talarnas, köpmännens och tjuvarnas gud i grekisk mytologi"
    },
    "tl": {
      "language": "tl",
      "value": "Diyos na mensahero sa Griyegong mitolohiya"
    },
    "tr": {
      "language": "tr",
      "value": "Tanrıların en kurnazı ve hızlısı, Zeus'un oğlu ve habercisi"
    },
    "vi": {
      "language": "vi",
      "value": "vị thần trong thần thoại Hy Lạp"
    },
    "zh": {
      "language": "zh",
      "value": "宙斯与迈亚的儿子，奥林匹斯十二主神之一"
    }
  },
